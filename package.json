{
  "name": "dsh-project-workspaces",
  "version": "0.1.66",
  "description": "DSH 项目工作区插件：项目 → 子工作区 → 会话的层级侧边栏，替换原生工作区栏，支持别名/标签/置顶/拖拽排序/会话导出/完成提示。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "pengxiaozi",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ds-harness",
    "plugin",
    "workspace",
    "project",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pengxiaozi/dsh-project-workspaces.git"
  },
  "homepage": "https://github.com/pengxiaozi/dsh-project-workspaces#readme",
  "bugs": {
    "url": "https://github.com/pengxiaozi/dsh-project-workspaces/issues"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/host.test.cjs tests/client.test.cjs",
    "check": "node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
